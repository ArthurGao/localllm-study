# ============================================================
# LLM 后端配置
# ============================================================

# 选择后端: ollama（本地）或 groq（云端）
LLM_BACKEND=ollama

# ============================================================
# Ollama 配置（本地 / 远程）
# ============================================================
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen3:8b

# 远程 Ollama 示例（取消注释）:
# OLLAMA_HOST=http://192.168.68.51:11434

# ============================================================
# Groq 配置（云端）
# ============================================================
GROQ_API_KEY=
GROQ_MODEL=qwen-qwq-32b

# Groq 可用的模型:
#   qwen-qwq-32b       - Qwen QWQ 32B (推理模型)
#   llama-3.3-70b-versatile - Llama 3.3 70B
#   llama-3.1-8b-instant    - Llama 3.1 8B (快速)
#   gemma2-9b-it            - Gemma 2 9B
#   mixtral-8x7b-32768      - Mixtral 8x7B
